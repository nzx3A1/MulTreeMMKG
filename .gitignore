# Python 缓存与测试缓存不进入仓库，避免提交运行时噪声。
__pycache__/
*.py[cod]
.pytest_cache/

# 本地环境、日志、模型输出和 MinerU 中间产物通常体积较大或包含敏感信息。
.env
logs/
data/
data/raw_pdf/
data/mineru_output/
# config/model_config.py
# 常见编辑器与系统文件。
.idea/
.vscode/
.DS_Store
Thumbs.db
**/*.json
!config/schema_alignment_rules.json
!config/multimodal_alignment_rules.json
*.html
*.css
*.js
*.png
.playwright-cli/*
node_cache/**
output/*
logs/*
result-front/*
*.jpg
*.jpeg
*.gif
*.svg
testdata/
data/*
tests/*
!tests/test_stage_05_schema_alignment.py
!tests/test_stage_06_multimodal_alignment.py
# 仅放行 MVP 评测集的可复现清单、Schema 与聚焦测试，避免扩大 JSON/测试跟踪范围。
!eval/dataset_split/manifest.json
!eval/mvp/**/*.json
!tests/test_mvp_eval_dataset.py
!tests/test_image_panel_splitter.py
!tests/test_llm_image_panel_rerun.py
*.log
logs/
.codex-tmp/*
